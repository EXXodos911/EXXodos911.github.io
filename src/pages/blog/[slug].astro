---
import { render } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../site';
import {
  estimateReadingTime,
  formatPostDate,
  getVisiblePosts,
  postPath,
  slugifyTag,
  tagPath,
  toISODate,
  withBase,
  type Post,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  // Posts are sorted newest first, so the previous index is the newer post.
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

type Props = { post: Post; newer?: Post; older?: Post };

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = estimateReadingTime(post.body ?? '');
const publishedISO = post.data.pubDate.toISOString();
const updatedISO = post.data.updatedDate?.toISOString();
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = toc.length >= 2;
const hasCode = /^\s*(```|~~~)/m.test(post.body ?? '');
// A cover doubles as the post's social preview, cropped to 1200×630 JPEG.
const socialImage = post.data.cover
  ? {
      src: (await getImage({ src: post.data.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src,
      width: 1200,
      height: 630,
      alt: post.data.coverAlt || post.data.title,
    }
  : undefined;
---

<SiteLayout
  title={`${post.data.title} — ${SITE.name}`}
  description={post.data.description}
  canonicalPath={postPath(post)}
  type="article"
  publishedTime={publishedISO}
  updatedTime={updatedISO}
  socialImage={socialImage}
>
  <article class={showToc ? 'article article--with-toc' : 'article'}>
    <a class="back-link" href={withBase('/')}>← All notes</a>

    <div class="article__layout">
      <div class="article__main">
        <header class="article__header">
          {post.data.draft && <p class="badge-draft">Draft · only visible in dev</p>}
          <h1>{post.data.title}</h1>
          <p class="article__description">{post.data.description}</p>
          {post.data.cover && (
            <Picture
              src={post.data.cover}
              formats={['avif', 'webp']}
              alt={post.data.coverAlt ?? ''}
              priority
              class="article__cover"
            />
          )}
          <div class="article__meta">
            <time datetime={toISODate(post.data.pubDate)}>{formatPostDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime}</span>
            {post.data.updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated <time datetime={toISODate(post.data.updatedDate)}>{formatPostDate(post.data.updatedDate)}</time></span>
              </>
            )}
          </div>
          {post.data.tags.length > 0 && (
            <ul class="tag-list tag-list--article" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li><a class="tag tag--link" href={withBase(tagPath(slugifyTag(tag)))}>{tag}</a></li>
              ))}
            </ul>
          )}
        </header>

        {showToc && (
          <details class="toc-inline">
            <summary>
              <span>On this page</span>
              <span class="toc-inline__count">{toc.length} sections</span>
            </summary>
            <nav class="toc" aria-label="Table of contents">
              <ol>
                {toc.map((entry) => (
                  <li class={entry.depth === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
                    <a href={`#${entry.slug}`}>{entry.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )}

        <div class="article__body">
          <Content />
        </div>

        {(newer || older) && (
          <nav class="post-nav" aria-label="More notes">
            {older ? (
              <a class="post-nav__card" href={withBase(postPath(older))} rel="prev">
                <span class="post-nav__direction">← Older</span>
                <span class="post-nav__title">{older.data.title}</span>
              </a>
            ) : <span />}
            {newer && (
              <a class="post-nav__card post-nav__card--newer" href={withBase(postPath(newer))} rel="next">
                <span class="post-nav__direction">Newer →</span>
                <span class="post-nav__title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </div>

      {showToc && (
        <aside class="toc-side">
          <nav class="toc" aria-label="Table of contents">
            <p class="toc__title">On this page</p>
            <div class="toc__rail">
              <span class="toc__marker" aria-hidden="true"></span>
              <ol>
                {toc.map((entry) => (
                  <li class={entry.depth === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
                    <a href={`#${entry.slug}`}>{entry.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        </aside>
      )}
    </div>
  </article>

  {(showToc || hasCode) && (
    <script>
      import '../../scripts/article';
    </script>
  )}
</SiteLayout>
