---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../site';
import { getVisiblePosts, groupByTag, tagPath, withBase } from '../../utils/posts';

const groups = groupByTag(await getVisiblePosts());
---

<SiteLayout title={`Tags — ${SITE.name}`} description="Browse notes by tag." canonicalPath="/tags">
  <header class="page-header">
    <h1>Tags</h1>
  </header>

  {groups.length === 0 && <p class="empty">No tags yet.</p>}

  <ul class="tag-index" aria-label="All tags">
    {groups.map((group) => (
      <li>
        <a href={withBase(tagPath(group.slug))}>
          #{group.label}
          <span class="tag-count">
            {group.posts.length}<span class="visually-hidden"> {group.posts.length === 1 ? 'note' : 'notes'}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <p class="tags-index-link"><a href={withBase('/')}>← All notes</a></p>
</SiteLayout>
