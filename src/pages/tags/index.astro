---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { slugifyTag } from '../../utils/posts';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Tags" description="Browse notes by tag." canonicalPath="/tags">
  <header class="page-header">
    <h1>Tags</h1>
  </header>

  {tags.length === 0 && <p class="empty">No tags yet.</p>}

  <ul class="tag-index" aria-label="All tags">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`${base}tags/${slugifyTag(tag)}`}>#{tag} <span class="tag-count">{count}</span></a>
      </li>
    ))}
  </ul>

  <p class="tags-index-link"><a href={base}>← All notes</a></p>
</SiteLayout>
