---
import PostRow from '../../components/PostRow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE } from '../../site';
import { getVisiblePosts, groupByTag, tagPath, type TagGroup } from '../../utils/posts';

export async function getStaticPaths() {
  const groups = groupByTag(await getVisiblePosts());
  return groups.map((group) => ({ params: { tag: group.slug }, props: { group } }));
}

type Props = { group: TagGroup };

const { group } = Astro.props;
---

<SiteLayout
  title={`Notes tagged “${group.label}” — ${SITE.name}`}
  description={`Notes tagged with ${group.label}.`}
  canonicalPath={tagPath(group.slug)}
>
  <header class="page-header">
    <p class="eyebrow">Tag</p>
    <h1 class="tag-title">{group.label}</h1>
  </header>

  <section class="post-list" aria-label={`Posts tagged ${group.label}`}>
    {group.posts.map((post, index) => <PostRow post={post} index={index} />)}
  </section>

  <p class="tags-index-link"><a href="/tags">← All tags</a></p>
</SiteLayout>
