---
import PostRow from '../components/PostRow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getVisiblePosts, withBase } from '../utils/posts';

const posts = await getVisiblePosts();
---

<SiteLayout canonicalPath="/">
  <header class="page-header">
    <h1>Notes</h1>
  </header>

  <section class="post-list" aria-label="Blog posts">
    {posts.length === 0 && <p class="empty">No notes yet. Check back soon.</p>}
    {posts.map((post, index) => <PostRow post={post} index={index} />)}
  </section>

  <p class="tags-index-link"><a href={withBase('/tags')}>Browse by tag →</a></p>
</SiteLayout>
