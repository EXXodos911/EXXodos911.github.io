---
import Sidebar from '../components/Sidebar.astro';
import { SITE } from '../site';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string;
  updatedTime?: string;
  noindex?: boolean;
  /** Overrides SITE.socialImage. `src` is a root-relative or absolute URL. */
  socialImage?: { src: string; width: number; height: number; alt: string };
};

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = '/',
  type = 'website',
  publishedTime,
  updatedTime,
  noindex = false,
  socialImage,
} = Astro.props;
// `site` in astro.config.mjs is the single source of truth for the public URL.
const absoluteUrl = (path: string) => new URL(path, Astro.site).href;
const canonicalUrl = canonicalPath ? absoluteUrl(canonicalPath) : undefined;
const homeUrl = absoluteUrl('/');
const ogImage = socialImage ?? SITE.socialImage;
const socialImageUrl = absoluteUrl(ogImage.src);
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalUrl,
      image: socialImageUrl,
      datePublished: publishedTime,
      ...(updatedTime ? { dateModified: updatedTime } : {}),
      mainEntityOfPage: canonicalUrl,
      inLanguage: 'en',
      author: { '@type': 'Person', name: SITE.name, url: homeUrl },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: title,
      description,
      url: canonicalUrl,
      image: socialImageUrl,
      inLanguage: 'en',
      author: { '@type': 'Person', name: SITE.name, url: homeUrl },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141415" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageUrl.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && updatedTime && (
      <meta property="article:modified_time" content={updatedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    <title>{title}</title>
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="shell">
      <Sidebar />
      <main class="content" id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
