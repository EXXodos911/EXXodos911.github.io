---
import TagList from './TagList.astro';
import { estimateReadingTime, formatPostDate, postPath, toISODate, type Post } from '../utils/posts';

type Props = {
  post: Post;
  index: number;
};

const { post, index } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class="post-row">
  <div class="post-row__number" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </div>

  <div class="post-row__body">
    <!-- The title link stretches over the whole row; tag links sit above it. -->
    {post.data.draft && <p class="badge-draft">Draft</p>}
    <h2><a class="post-row__link" href={postPath(post)}>{title}</a></h2>
    <p>{description}</p>
    <div class="post-row__meta">
      <time datetime={toISODate(pubDate)}>{formatPostDate(pubDate)}</time>
      <span>{estimateReadingTime(post.body ?? '')}</span>
      <TagList tags={tags} />
    </div>
  </div>

  <span class="post-row__arrow" aria-hidden="true">↗</span>
</article>
