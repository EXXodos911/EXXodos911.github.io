---
import { SITE } from '../site';
import { withBase } from '../utils/posts';

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const pageLinks = [
  { label: 'Notes', href: withBase('/') },
  { label: 'Tags', href: withBase('/tags') },
];
---

<aside class="sidebar">
  <div>
    <a class="identity" href={withBase('/')} aria-label="Go to homepage">
      <span class="identity__mark" aria-hidden="true"></span>
      <span>{SITE.name}</span>
    </a>

    <p class="about">
      {SITE.bio}
    </p>

    <nav aria-label="Site links">
      {pageLinks.map((link) => (
        <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>{link.label}</a>
      ))}
      {SITE.socials.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
  </div>

  <p class="copyright">© {currentYear} {SITE.name}</p>
</aside>
