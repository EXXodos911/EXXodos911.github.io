---
import { SITE } from '../site';

const currentYear = new Date().getFullYear();
// Pages build as /tags.html (and /index.html), and load at /tags or /tags/.
const currentPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/(.)\/$/, '$1');
const pageLinks = [
  { label: 'Notes', href: '/' },
  { label: 'Tags', href: '/tags' },
];
---

<aside class="sidebar">
  <div>
    <a class="identity" href="/">
      <span class="identity__mark" aria-hidden="true"></span>
      <span>{SITE.name}</span>
    </a>

    <p class="about">
      {SITE.bio}
    </p>

    <nav aria-label="Site links">
      {pageLinks.map((link) => (
        <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>{link.label}</a>
      ))}
      {SITE.socials.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>

  <p class="copyright">© {currentYear} {SITE.name}</p>
</aside>
