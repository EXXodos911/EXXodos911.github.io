---
import { SITE } from '../site';

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<aside class="sidebar">
  <div>
    <a class="identity" href={base} aria-label="Go to homepage">
      <span class="identity__mark" aria-hidden="true"></span>
      <span>{SITE.name}</span>
    </a>

    <p class="about">
      {SITE.bio}
    </p>

    <nav aria-label="Site links">
      <a href={base}>Notes</a>
      <a href={`${base}tags`}>Tags</a>
      {SITE.socials.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
      ))}
      <a href={`${base}rss.xml`}>RSS</a>
    </nav>
  </div>

  <p class="copyright">© {currentYear} {SITE.name}</p>
</aside>
